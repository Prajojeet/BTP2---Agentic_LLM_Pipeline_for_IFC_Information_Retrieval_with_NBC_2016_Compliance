# --- Required: OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Optional: model selection ---
# Backbone for both the tool-selector and the ReAct agent.
# Recommended (in order):
#   gpt-5.4              <- frontier, best accuracy (default)
#   gpt-5.4-mini         <- cheaper, still very good
#   gpt-5.2              <- previous-gen frontier
#   gpt-4.1              <- if you don't have GPT-5 access yet
IFC_AGENT_MODEL=gpt-5.4

# Temperature (kept at 0 to maximise determinism, raise for more exploratory behaviour).
IFC_AGENT_TEMPERATURE=0

# Max ReAct loop iterations (the paper does not cap this; 25 is a safe ceiling).
IFC_AGENT_MAX_ITERATIONS=25

# --- Optional: LangSmith tracing (extremely useful while debugging) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ifc-agent
